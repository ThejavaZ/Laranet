@page
@model Laranet.Samples.Admin.Pages.Admin.Products.IndexModel

<h1>Products</h1>

<form method="get">
    <label>
        Search
        <input name="Search" value="@Model.Search" />
    </label>
    <button type="submit">Search</button>
    <a asp-page="Create">Create product</a>
</form>

<table>
    <thead>
        <tr><th>ID</th><th>Name</th><th>Price</th><th>Active</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var product in Model.Results.Items)
    {
        <tr>
            <td>@product["Id"]</td>
            <td>@product["Name"]</td>
            <td>@product["Price"]</td>
            <td>@product["IsActive"]</td>
            <td>
                <a asp-page="Edit" asp-route-id="@product["Id"]">Edit</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@product["Id"]">
                    <button type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<p>Page @Model.Results.Page of @Model.Results.TotalPages (@Model.Results.TotalCount products)</p>
