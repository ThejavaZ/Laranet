@page "/admin/login"
@model Laranet.Admin.AspNetCore.Areas.Admin.Pages.LoginModel
@inject IWebHostEnvironment HostEnvironment
@{
    Layout = "/Areas/Admin/Pages/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = "Login";
}

<div class="admin-login-layout">
    <aside class="admin-login-brand">
        <div class="admin-login-brand-mark" aria-hidden="true">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2 2 7l10 5 10-5-10-5z"></path>
                <path d="M2 17l10 5 10-5"></path>
                <path d="M2 12l10 5 10-5"></path>
            </svg>
        </div>
        <p class="admin-login-eyebrow">Laranet</p>
        <h1>Admin workspace</h1>
        <p class="admin-login-brand-copy">
            A focused workspace to manage your application data with confidence.
        </p>
        <div class="admin-login-brand-line" aria-hidden="true"></div>
        <p class="admin-login-brand-meta">Secure access · @HostEnvironment.EnvironmentName</p>
    </aside>

    <section class="admin-login-card" aria-labelledby="login-title">
        <div class="admin-login-header">
            <div>
                <span class="admin-login-kicker">Welcome back</span>
                <h2 id="login-title">Sign in to continue</h2>
                <p>Use your administrator account to access the dashboard.</p>
            </div>
            <span class="admin-environment"
                  aria-label="Environment: @HostEnvironment.EnvironmentName">
                Environment: @HostEnvironment.EnvironmentName
            </span>
        </div>

        <form method="post" class="admin-login-form">
            <input type="hidden" asp-for="ReturnUrl" />
            @if (Model.SessionExpired)
            {
                <div class="admin-alert admin-alert-warning" role="status">
                    Your session expired or was revoked. Please sign in again.
                </div>
            }
            <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert-error" role="alert"></div>

            <div class="admin-login-field">
                <label asp-for="UserName">Username</label>
                <div class="admin-login-input">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 21a8 8 0 0 0-16 0"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <input asp-for="UserName" autocomplete="username" required autofocus />
                </div>
                <span asp-validation-for="UserName" class="admin-field-error"></span>
            </div>

            <div class="admin-login-field">
                <label asp-for="Password">Password</label>
                <div class="admin-login-input">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <input asp-for="Password" type="password" autocomplete="current-password" required />
                    <button class="admin-password-toggle"
                            type="button"
                            data-password-toggle
                            aria-controls="Password"
                            aria-label="Show password"
                            aria-pressed="false">
                        <svg data-password-visible="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <svg data-password-visible="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
                            <path d="M3 3l18 18"></path>
                            <path d="M10.58 10.58a2 2 0 0 0 2.83 2.83"></path>
                            <path d="M9.88 4.24A10.94 10.94 0 0 1 12 4c6.5 0 10 8 10 8a17.7 17.7 0 0 1-3.16 4.19"></path>
                            <path d="M6.61 6.61C3.8 8.4 2 12 2 12s3.5 8 10 8a10.9 10.9 0 0 0 4.24-.88"></path>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="admin-field-error"></span>
            </div>

            <button class="admin-login-submit" type="submit">
                <span>Sign in</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linecap="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </form>

        <p class="admin-auth-link">
            <a asp-page="/ForgotPassword">Forgot your password?</a>
        </p>

        <div class="admin-login-footer">
            <span class="admin-login-status" aria-hidden="true"></span>
            <span>Protected administrator access</span>
        </div>
    </section>
</div>
