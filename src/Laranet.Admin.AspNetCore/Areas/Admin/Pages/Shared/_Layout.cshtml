<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Laranet Admin</title>
    <link rel="stylesheet" href="/_content/Laranet.Admin.AspNetCore/admin.css" />
    <script defer src="/_content/Laranet.Admin.AspNetCore/admin.js"></script>
</head>
<body class="admin-shell">
    <header class="admin-topbar">
        <button class="admin-hamburger" type="button" data-hamburger aria-label="Toggle navigation">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <a class="admin-brand" asp-page="/Index">
            <span class="admin-brand-mark">L</span>
            <span>Laranet Admin</span>
        </a>
        <div class="admin-topbar-actions">
            <span class="admin-environment">Development</span>
            <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" class="admin-logout-form">
                <button type="submit" class="admin-logout-button">Logout</button>
            </form>
        </div>
    </header>

    <div class="admin-layout">
        <aside class="admin-sidebar" data-sidebar>
            <p class="admin-sidebar-label">Workspace</p>
            <a class="admin-nav-link" asp-page="/Index">
                <span>▦</span>
                Dashboard
            </a>
            <a class="admin-nav-link" asp-page="/Resources/Index" asp-route-resource="Products">
                <span>▦</span>
                Products
            </a>
        </aside>

        <div class="admin-sidebar-overlay" data-sidebar-overlay></div>

        <main class="admin-content">
            @if (Context.Request.Query.TryGetValue("adminMessage", out var adminMessage))
            {
                <div class="admin-toast" role="status" data-toast>
                    <span>@adminMessage</span>
                    <button type="button" data-toast-close aria-label="Close notification">×</button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
