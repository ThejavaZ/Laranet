@page "/admin"
@model Laranet.Admin.AspNetCore.Areas.Admin.Pages.IndexModel

<div class="admin-page-heading">
    <div>
        <h1>Dashboard</h1>
        <p>Manage your application data from one place.</p>
    </div>
</div>

<div class="admin-dashboard">
    @if (Model.Resources.Count == 0)
    {
        @await Html.PartialAsync(
            "~/Areas/Admin/Pages/Components/_EmptyState.cshtml",
            new AdminEmptyStateView(
                "No resources registered",
                "Register an AdminResource to get started.",
                Icon: "resources"))
    }
    else
    {
        <div class="admin-resource-grid">
            @foreach (var resource in Model.Resources)
            {
                <a class="admin-resource-card"
                   asp-page="/Resources/Index"
                   asp-route-resource="@resource.Name">
                    <span class="admin-resource-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        </svg>
                    </span>
                    <span class="admin-resource-name">@resource.Name</span>
                    <span class="admin-resource-meta">
                        @resource.Fields.Count fields
                        @if (resource.SearchFields.Count > 0)
                        {
                            <span>· searchable</span>
                        }
                    </span>
                </a>
            }
        </div>
    }
</div>
