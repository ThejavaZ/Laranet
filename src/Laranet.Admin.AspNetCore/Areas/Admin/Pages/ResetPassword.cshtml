@page "/admin/reset-password"
@model Laranet.Admin.AspNetCore.Areas.Admin.Pages.ResetPasswordModel
@{
    Layout = "/Areas/Admin/Pages/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = "Reset password";
}

<div class="admin-auth-card">
    <div class="admin-auth-header">
        <h1>Choose a new password</h1>
        <p>Use a strong password with at least 12 characters.</p>
    </div>

    <form method="post" class="admin-form">
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert-error" role="alert"></div>
        <label class="admin-field">
            <span>New password</span>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="12" required autofocus />
        </label>
        <label class="admin-field">
            <span>Confirm new password</span>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="12" required />
        </label>
        <button class="admin-button" type="submit">Reset password</button>
    </form>
</div>
