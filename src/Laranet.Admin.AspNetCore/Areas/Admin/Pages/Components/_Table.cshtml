@using System.Globalization
@model AdminTableModel
@{
    var routeValues = new Dictionary<string, string>(Model.RouteValues, StringComparer.OrdinalIgnoreCase)
    {
        ["PageNumber"] = "1",
    };
}
<div class="admin-table-wrap">
    <table class="admin-table" aria-label="Data table">
        <thead class="admin-table-head">
            <tr>
                @if (Model.SupportsBulk)
                {
                    <th scope="col" class="admin-select-column">
                        <input type="checkbox"
                               data-select-all
                               form="bulk-form"
                               aria-label="Select all records" />
                    </th>
                }
                @foreach (var field in Model.Resource.Fields)
                {
                    var ariaSort = field.IsOrderable
                        ? Model.SortBy == field.Name
                            ? (Model.SortDescending ? "descending" : "ascending")
                            : "none"
                        : null;
                    <th scope="col" aria-sort="@ariaSort">
                        @if (field.IsOrderable)
                        {
                            var nextDescending = Model.SortBy == field.Name && !Model.SortDescending;
                            var sortRoute = new Dictionary<string, string>(routeValues, StringComparer.OrdinalIgnoreCase)
                            {
                                ["SortBy"] = field.Name,
                                ["SortDescending"] = nextDescending.ToString(),
                            };
                            <a class="admin-sort-link" asp-page="/Resources/Index" asp-all-route-data="@sortRoute">
                                @Model.Label(field)
                                @if (Model.SortBy == field.Name)
                                {
                                    <span aria-hidden="true">@(Model.SortDescending ? "↓" : "↑")</span>
                                }
                            </a>
                        }
                        else
                        {
                            @Model.Label(field)
                        }
                    </th>
                }
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Results.Items)
            {
                <tr>
                    @if (Model.SupportsBulk)
                    {
                        <td class="admin-select-cell" data-label="Select">
                            <input type="checkbox"
                                   name="keys"
                                   value="@item.GetValueOrDefault(Model.Resource.KeyField.Name)"
                                   form="bulk-form"
                                   aria-label="Select record" />
                        </td>
                    }
                    @foreach (var field in Model.Resource.Fields)
                    {
                        var value = item.GetValueOrDefault(field.Name);
                        <td data-label="@Model.Label(field)">
                            @if (field.Type == typeof(bool) && value is bool boolValue)
                            {
                                <span class="admin-badge @(boolValue ? "admin-badge-success" : "admin-badge-neutral")">
                                    @(boolValue ? "Active" : "Inactive")
                                </span>
                            }
                            else if (field.IsKey)
                            {
                                <a class="admin-link"
                                   asp-page="/Resources/Details"
                                   asp-route-resource="@Model.Resource.Name"
                                   asp-route-key="@value">
                                    @Model.FormatValue(field, value)
                                </a>
                            }
                            else
                            {
                                @Model.FormatValue(field, value)
                            }
                        </td>
                    }
                    <td class="admin-actions" data-label="Actions">
                        <a class="admin-icon-button"
                           asp-page="/Resources/Edit"
                           asp-route-resource="@Model.Resource.Name"
                           asp-route-key="@item.GetValueOrDefault(Model.Resource.KeyField.Name)"
                           title="Edit"
                           aria-label="Edit">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 20h9"></path>
                                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                            </svg>
                        </a>
                        <form method="post"
                              data-confirm-form="Delete this record?"
                              data-loading-form
                              asp-page-handler="Delete"
                              asp-route-resource="@Model.Resource.Name"
                              asp-route-key="@item.GetValueOrDefault(Model.Resource.KeyField.Name)">
                            <button class="admin-icon-button admin-icon-button-danger"
                                    type="submit"
                                    title="Delete"
                                    aria-label="Delete"
                                    data-loading-button>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6l-1 14H6L5 6"></path>
                                    <path d="M10 11v6"></path>
                                    <path d="M14 11v6"></path>
                                    <path d="M9 6V4h6v2"></path>
                                </svg>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
