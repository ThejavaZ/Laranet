@inject IAdminResourceRegistry Resources
@{
    var currentResource = Context.Request.RouteValues["resource"]?.ToString();
    var currentPath = Context.Request.Path.Value?.TrimEnd('/') ?? string.Empty;
    var onDashboard = string.Equals(currentPath, "/admin", StringComparison.OrdinalIgnoreCase);
}
<aside class="admin-sidebar" data-sidebar>
    <p class="admin-sidebar-label">Workspace</p>

    <a class="admin-nav-link @(onDashboard ? "is-active" : null)"
       asp-page="/Index"
       aria-current="@(onDashboard ? "page" : null)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
        </svg>
        Dashboard
    </a>

    @foreach (var resource in Resources.Resources)
    {
        var isActive = string.Equals(currentResource, resource.Name, StringComparison.OrdinalIgnoreCase);
        <a class="admin-nav-link @(isActive ? "is-active" : null)"
           asp-page="/Resources/Index"
           asp-route-resource="@resource.Name"
           aria-current="@(isActive ? "page" : null)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            </svg>
            @resource.Name
        </a>
    }
</aside>
