@{
    var direction = Context.Request.Query["dir"] == "rtl" ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="en" dir="@direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Laranet Admin</title>
    <link rel="stylesheet" href="/_content/Laranet.Admin.AspNetCore/admin.css" />
    <script defer src="/_content/Laranet.Admin.AspNetCore/admin.js"></script>
</head>
<body class="admin-auth-shell">
    <main class="admin-auth-content">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
