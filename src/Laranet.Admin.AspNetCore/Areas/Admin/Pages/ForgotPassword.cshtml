@page "/admin/forgot-password"
@model Laranet.Admin.AspNetCore.Areas.Admin.Pages.ForgotPasswordModel
@{
    Layout = "/Areas/Admin/Pages/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = "Forgot password";
}

<div class="admin-auth-card">
    <div class="admin-auth-header">
        <h1>Reset your password</h1>
        <p>Enter your username and we will send instructions if the account exists.</p>
    </div>

    @if (Model.Sent)
    {
        <div class="admin-alert admin-alert-info" role="status">
            If the account exists, reset instructions have been sent.
        </div>
    }

    <form method="post" class="admin-form">
        <label class="admin-field">
            <span>Username</span>
            <input asp-for="UserName" autocomplete="username" required autofocus />
        </label>
        <button class="admin-button" type="submit">Send reset instructions</button>
    </form>

    <p class="admin-auth-link">
        <a asp-page="/Login">Back to login</a>
    </p>
</div>
