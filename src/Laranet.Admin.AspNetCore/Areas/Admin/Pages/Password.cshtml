@page "/admin/password"
@model Laranet.Admin.AspNetCore.Areas.Admin.Pages.PasswordModel
@{
    Layout = "/Areas/Admin/Pages/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = "Change password";
}

<div class="admin-auth-card">
    <div class="admin-auth-header">
        <h1>Change password</h1>
        <p>Choose a new password for your admin account.</p>
    </div>

    <form method="post" class="admin-form">
        <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert-error" role="alert"></div>

        <label class="admin-field">
            <span>Current password</span>
            <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required autofocus />
            <span asp-validation-for="CurrentPassword" class="admin-field-error"></span>
        </label>

        <label class="admin-field">
            <span>New password</span>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="12" required />
            <span asp-validation-for="NewPassword" class="admin-field-error"></span>
        </label>

        <label class="admin-field">
            <span>Confirm new password</span>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="12" required />
            <span asp-validation-for="ConfirmPassword" class="admin-field-error"></span>
        </label>

        <button class="admin-button" type="submit">Change password</button>
    </form>
</div>
