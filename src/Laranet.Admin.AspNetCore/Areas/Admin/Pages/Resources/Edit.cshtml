@page "/admin/{resource}/{key}/edit"
@model Laranet.Admin.AspNetCore.Areas.Admin.Pages.Resources.EditModel

<div class="admin-page-heading">
    <div>
        <h1>Edit @Model.Resource.Name.TrimEnd('s')</h1>
        <p>Update this record.</p>
    </div>
</div>

<div class="admin-card admin-form-card">
<form class="admin-form" method="post" data-loading-form>
    @foreach (var field in Model.Resource.Form?.Fields ?? [])
    {
        <div class="admin-form-field">
            <label>
            @Model.L(field)
            @if (Model.Lookups.TryGetValue(field.Name, out var options))
            {
                <select name="@field.Name">
                    @foreach (var option in options)
                    {
                        <option value="@option.Key"
                                selected="@(Convert.ToString(Model.Values.GetValueOrDefault(field.Name)) == Convert.ToString(option.Key))">
                            @option.Label
                        </option>
                    }
                </select>
            }
            else if (field.FieldType == AdminFieldType.TextArea)
            {
                <textarea name="@field.Name" rows="@(field.Rows ?? 4)">@Model.Values.GetValueOrDefault(field.Name)</textarea>
            }
            else
            {
                <input name="@field.Name"
                       type="@Laranet.Admin.AspNetCore.AdminInputTypeResolver.Resolve(field)"
                       value="@Model.Values.GetValueOrDefault(field.Name)"
                       min="@field.Min"
                       max="@field.Max"
                       step="@field.Step"
                       maxlength="@(field.MaxLength?.ToString())"
                       minlength="@(field.MinLength?.ToString())"
                       required="@(field.IsRequired ? "required" : null)" />
            }
            </label>
        </div>
    }
    <div class="admin-form-actions">
        <button class="admin-button" type="submit" data-loading-button>Save</button>
        <a class="admin-button-secondary" asp-page="/Resources/Index" asp-route-resource="@Model.Resource.Name">Cancel</a>
    </div>
</form>
</div>
