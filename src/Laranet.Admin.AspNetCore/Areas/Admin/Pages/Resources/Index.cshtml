@page "/admin/{resource}"
@model Laranet.Admin.AspNetCore.Areas.Admin.Pages.Resources.IndexModel

<div class="admin-page-heading">
    <div>
        <h1>@Model.Resource.Name</h1>
        <p>Manage your @Model.Resource.Name.ToLowerInvariant() from one place.</p>
    </div>
    <a class="admin-button" asp-page="/Resources/Create" asp-route-resource="@Model.Resource.Name">
        Create @Model.Resource.Name.TrimEnd('s')
    </a>
</div>

<div class="admin-card">
<div class="admin-toolbar">
<form class="admin-search" method="get" data-loading-form>
    <label>
        <span class="sr-only">Search</span>
        <input name="Search" value="@Model.Search" />
    </label>
    @foreach (var filter in Model.Resource.Filters)
    {
        <label class="admin-filter">
            <span>@filter.Label</span>
            @if (filter.ValueType == typeof(bool))
            {
                <select name="@filter.Name">
                    <option value="">All</option>
                    <option value="true" selected="@(Request.Query[filter.Name] == "true")">Active</option>
                    <option value="false" selected="@(Request.Query[filter.Name] == "false")">Inactive</option>
                </select>
            }
            else
            {
                <input name="@filter.Name" value="@Request.Query[filter.Name]" />
            }
        </label>
    }
    <button class="admin-button-secondary" type="submit" data-loading-button>Search</button>
</form>

<span class="admin-muted">@Model.Results.TotalCount results</span>
    <a class="admin-button-secondary" asp-page-handler="Export" asp-route-resource="@Model.Resource.Name">Export CSV</a>
</div>

@if (Model.SupportsBulk)
{
    <form id="bulk-form" class="admin-bulk-form" method="post" asp-page-handler="Bulk"
          asp-route-resource="@Model.Resource.Name"
          data-confirm="Apply soft-delete to the selected records?"
          data-loading-form>
        <input type="hidden" name="action" value="soft-delete" />
        <button class="admin-button-secondary" type="submit" data-loading-button>
            Soft-delete selected
        </button>
    </form>
}

@if (Model.Results.Items.Count == 0)
{
    <div class="admin-empty-state">
        <div class="admin-empty-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </div>
        <h2>No records found</h2>
        <p>Try adjusting your search or filters, or create a new record.</p>
        <a class="admin-button" asp-page="/Resources/Create" asp-route-resource="@Model.Resource.Name">Create @Model.Resource.Name.TrimEnd('s')</a>
    </div>
}
else
{
<table class="admin-table" aria-label="Data table">
    <thead>
        <tr>
        @foreach (var field in Model.Resource.Fields)
        {
            <th>
            @(Model.L(field))
            @if (field.IsOrderable)
            {
                var descending = Model.SortBy == field.Name && !Model.SortDescending;
                <a class="admin-sort-link"
                   asp-page="/Resources/Index"
                   asp-route-resource="@Model.Resource.Name"
                   asp-route-Search="@Model.Search"
                   asp-route-PageNumber="1"
                   asp-route-SortBy="@field.Name"
                   asp-route-SortDescending="@descending">
                    @field.Label
                    @if (Model.SortBy == field.Name)
                    {
                        <span aria-hidden="true">@(Model.SortDescending ? "↓" : "↑")</span>
                    }
                </a>
            }
            else
            {
                @field.Label
            }
            </th>
        }
        <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Results.Items)
    {
        <tr>
        @foreach (var field in Model.Resource.Fields)
        {
            <td>
                @if (field.IsKey)
                {
                    <a class="admin-link" asp-page="/Resources/Details"
                       asp-route-resource="@Model.Resource.Name"
                       asp-route-key="@item.GetValueOrDefault(field.Name)">
                        @item.GetValueOrDefault(field.Name)
                    </a>
                }
                else
                {
                    @item.GetValueOrDefault(field.Name)
                }
            </td>
        }
        <td class="admin-actions">
            @if (Model.SupportsBulk)
            {
                <input type="checkbox" name="keys" value="@item.GetValueOrDefault(Model.Resource.KeyField.Name)" form="bulk-form" />
            }
            <a asp-page="/Resources/Edit"
               asp-route-resource="@Model.Resource.Name"
               asp-route-key="@item.GetValueOrDefault(Model.Resource.KeyField.Name)">Edit</a>
            <form method="post"
                  data-modal-confirm="Delete this record?"
                  data-loading-form
                  asp-page-handler="Delete"
                  asp-route-resource="@Model.Resource.Name"
                  asp-route-key="@item.GetValueOrDefault(Model.Resource.KeyField.Name)">
                <button class="admin-danger" type="submit" data-loading-button>Delete</button>
            </form>
        </td>
        </tr>
    }
    </tbody>
</table>
}

<div class="admin-footer">
    <form method="get" class="admin-page-size">
        <input type="hidden" name="resource" value="@Model.Resource.Name" />
        <input type="hidden" name="Search" value="@Model.Search" />
        <input type="hidden" name="SortBy" value="@Model.SortBy" />
        <input type="hidden" name="SortDescending" value="@Model.SortDescending" />
        <label>
            Page size
            <select name="PageSize" onchange="this.form.submit()">
                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
                <option value="100" selected="@(Model.PageSize == 100)">100</option>
            </select>
        </label>
    </form>
    <span>Page @Model.Results.Page of @Model.Results.TotalPages</span>
    <span>@Model.Results.TotalCount items</span>
</div>
</div>
