@page "/admin/{resource}/create"
@model Laranet.Admin.AspNetCore.Areas.Admin.Pages.Resources.CreateModel

<div class="admin-page-heading">
    <div>
        <h1>Create @AdminPageModelHelper.SingularName(Model.Resource)</h1>
        <p>Add a new record to @Model.Resource.Name.</p>
    </div>
</div>

<div class="admin-card admin-form-card">
<form class="admin-form" method="post" data-loading-form>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="admin-alert admin-alert-error" role="alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }
    @{
        var fields = Model.Resource.Form?.Fields ?? Model.Resource.Fields;
    }
    @await Html.PartialAsync(
        "~/Areas/Admin/Pages/Components/_FormFields.cshtml",
        new AdminFormView(
            fields,
            Model.L,
            field => field.DefaultValue,
            field => Model.Lookups.GetValueOrDefault(field.Name)))
    <div class="admin-form-actions">
        @await Html.PartialAsync(
            "~/Areas/Admin/Pages/Components/_Button.cshtml",
            new AdminButtonView("Create", Type: "submit", ShowLoading: true))
        @await Html.PartialAsync(
            "~/Areas/Admin/Pages/Components/_Button.cshtml",
            new AdminButtonView(
                "Cancel",
                Url.Page("/Resources/Index", new { resource = Model.Resource.Name }),
                Variant: "secondary"))
    </div>
</form>
</div>
