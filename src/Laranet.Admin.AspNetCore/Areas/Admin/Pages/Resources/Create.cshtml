@page "/admin/{resource}/create"
@model Laranet.Admin.AspNetCore.Areas.Admin.Pages.Resources.CreateModel

<div class="admin-page-heading">
    <div>
        <h1>Create @Model.Resource.Name.TrimEnd('s')</h1>
        <p>Add a new record to @Model.Resource.Name.</p>
    </div>
</div>

<div class="admin-card admin-form-card">
<form class="admin-form" method="post" data-loading-form>
    @foreach (var field in Model.Resource.Form?.Fields ?? [])
    {
        <div class="admin-form-field">
            <label>
            @field.Label
            @if (Model.Lookups.TryGetValue(field.Name, out var options))
            {
                <select name="@field.Name">
                    <option value="">Select...</option>
                    @foreach (var option in options)
                    {
                        <option value="@option.Key">@option.Label</option>
                    }
                </select>
            }
            else
            {
                <input name="@field.Name" type="@(field.Type == typeof(bool) ? "checkbox" : "text")" />
            }
            </label>
        </div>
    }
    <div class="admin-form-actions">
        <button class="admin-button" type="submit" data-loading-button>Create</button>
        <a class="admin-button-secondary" asp-page="/Resources/Index" asp-route-resource="@Model.Resource.Name">Cancel</a>
    </div>
</form>
</div>
