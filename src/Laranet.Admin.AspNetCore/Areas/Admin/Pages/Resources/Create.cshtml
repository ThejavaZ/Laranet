@page "/admin/{resource}/create"
@model Laranet.Admin.AspNetCore.Areas.Admin.Pages.Resources.CreateModel

<div class="admin-page-heading">
    <div>
        <h1>Create @Model.Resource.Name.TrimEnd('s')</h1>
        <p>Add a new record to @Model.Resource.Name.</p>
    </div>
</div>

<div class="admin-card admin-form-card">
<form class="admin-form" method="post" data-loading-form>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="admin-alert admin-alert-error" role="alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }
    @foreach (var field in Model.Resource.Form?.Fields ?? Model.Resource.Fields)
    {
        <div class="admin-form-field">
            <label>
            @Model.L(field)
            @if (Model.Lookups.TryGetValue(field.Name, out var options))
            {
                <select name="@field.Name">
                    <option value="">Select...</option>
                    @foreach (var option in options)
                    {
                        <option value="@option.Key">@option.Label</option>
                    }
                </select>
            }
            else if (field.Type == typeof(bool))
            {
                <label class="admin-toggle">
                    <input name="@field.Name" type="checkbox" value="true" />
                    <span class="admin-toggle-track">
                        <span class="admin-toggle-thumb"></span>
                    </span>
                    <span class="admin-toggle-label">@(field.DefaultValue == "true" ? "Enabled" : "Disabled")</span>
                </label>
                <input type="hidden" name="@field.Name" value="false" />
            }
            else if (field.FieldType == AdminFieldType.TextArea)
            {
                <textarea name="@field.Name" rows="@(field.Rows ?? 4)" placeholder="@field.Placeholder">@field.DefaultValue</textarea>
            }
            else
            {
                <input name="@field.Name"
                       type="@Laranet.Admin.AspNetCore.AdminInputTypeResolver.Resolve(field)"
                       placeholder="@field.Placeholder"
                       value="@field.DefaultValue"
                       min="@field.Min"
                       max="@field.Max"
                       step="@field.Step"
                       maxlength="@(field.MaxLength?.ToString())"
                       minlength="@(field.MinLength?.ToString())"
                       required="@(field.IsRequired ? "required" : null)" />
            }
            </label>
        </div>
    }
    <div class="admin-form-actions">
        <button class="admin-button" type="submit" data-loading-button>Create</button>
        <a class="admin-button-secondary" asp-page="/Resources/Index" asp-route-resource="@Model.Resource.Name">Cancel</a>
    </div>
</form>
</div>
