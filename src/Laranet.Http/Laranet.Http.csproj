<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package metadata -->
    <PackageId>Laranet.Http</PackageId>
    <Version>0.2.0</Version>
    <Description>
      Optional convenience layer over HttpClient for typed, cancellation-aware API calls with safe retries.
    </Description>
    <Authors>TheJavaZ</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/TheJavaZ/Laranet</RepositoryUrl>
    <PackageTags>dotnet;toolkit;http;httpclient;json;api;rest;retry;resilience</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
